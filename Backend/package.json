{
  "name": "dei-private-cloud-backend",
  "version": "1.0.0",
  "description": "Backend API for DEI Private Cloud frontend replacement",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/unit --coverage",
    "test:integration": "jest tests/integration --coverage",
    "test:security": "jest tests/security --coverage",
    "test:all": "jest tests/unit tests/integration tests/security --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!src/config/*.js",
      "!src/server.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 50,
        "functions": 50,
        "lines": 50,
        "statements": 50
      }
    },
    "setupFilesAfterEnv": ["./tests/unit/setup.js", "./tests/integration/setup.js"],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/unit/**/*.test.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/tests/fixtures/"
    ]
  },
  "keywords": [
    "private-cloud",
    "dei",
    "vps",
    "virtual-servers",
    "angular",
    "nodejs",
    "ldap"
  ],
  "author": "Tiago Pinto Soares",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "ldapjs": "^3.0.7",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "eslint": "^8.47.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.28.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "directories": {
    "test": "tests"
  }
}
